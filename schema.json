{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TSHUD default-off rules",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "author",
          "targetKind",
          "match",
          "action",
          "reasonKind",
          "reasonText",
          "sourceType",
          "sourceUrl",
          "observedAt",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "author": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "targetKind": {
            "enum": [
              "scenario",
              "route",
              "vehicle"
            ]
          },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "anyOf"
            ],
            "properties": {
              "anyOf": {
                "type": "array",
                "minItems": 1,
                "maxItems": 512,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "allOf"
                  ],
                  "properties": {
                    "allOf": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 8,
                      "items": {
                        "oneOf": [
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "field",
                              "equals"
                            ],
                            "properties": {
                              "field": {
                                "enum": [
                                  "scenarioRelativePath",
                                  "selectedRouteRelativePath",
                                  "selectedVehicleRelativePath"
                                ]
                              },
                              "equals": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 400
                              }
                            }
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "field",
                              "prefix"
                            ],
                            "properties": {
                              "field": {
                                "enum": [
                                  "scenarioRelativePath",
                                  "selectedRouteRelativePath",
                                  "selectedVehicleRelativePath"
                                ]
                              },
                              "prefix": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 400
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "action": {
            "const": "defaultOff"
          },
          "reasonKind": {
            "enum": [
              "authorPreference",
              "publicationRestriction"
            ]
          },
          "reasonText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 320
          },
          "sourceType": {
            "enum": [
              "officialTerms",
              "publicXStatement",
              "directVerifiedRequest"
            ]
          },
          "sourceUrl": {
            "type": "string",
            "minLength": 0,
            "maxLength": 2048
          },
          "observedAt": {
            "type": "string",
            "format": "date"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
